/**
 * Ejercicio 10: Lista doblemente enlazada genérica.
 */

// -----------------------------------------------------------------------------
// 1. CLASE NODO GENÉRICO
// -----------------------------------------------------------------------------
class Nodo<T> {
    T dato;
    Nodo<T> siguiente;
    Nodo<T> anterior;

    public Nodo(T dato) {
        this.dato = dato;
        this.siguiente = null;
        this.anterior = null;
    }
}

// -----------------------------------------------------------------------------
// 2. CLASE LISTA DOBLEMENTE ENLAZADA GENÉRICA
// -----------------------------------------------------------------------------
class ListaDoblementeEnlazada<T> {
    private Nodo<T> cabeza;
    private Nodo<T> cola;
    private int tamanio;

    public ListaDoblementeEnlazada() {
        this.cabeza = null;
        this.cola = null;
        this.tamanio = 0;
    }

    public boolean estaVacia() {
        return cabeza == null;
    }

    public int getTamanio() {
        return tamanio;
    }

    // Insertar un elemento al inicio de la lista
    public void insertarInicio(T dato) {
        Nodo<T> nuevo = new Nodo<>(dato);
        if (estaVacia()) {
            cabeza = nuevo;
            cola = nuevo;
        } else {
            nuevo.siguiente = cabeza;
            cabeza.anterior = nuevo;
            cabeza = nuevo;
        }
        tamanio++;
    }

    // Insertar un elemento al final de la lista
    public void insertarFinal(T dato) {
        Nodo<T> nuevo = new Nodo<>(dato);
        if (estaVacia()) {
            cabeza = nuevo;
            cola = nuevo;
        } else {
            cola.siguiente = nuevo;
            nuevo.anterior = cola;
            cola = nuevo;
        }
        tamanio++;
    }

    // Eliminar la primera ocurrencia de un elemento
    public boolean eliminar(T dato) {
        if (estaVacia()) {
            return false;
        }

        Nodo<T> actual = cabeza;

        while (actual != null) {
            // Comparación genérica de datos usando equals
            if ((dato == null && actual.dato == null) || (dato != null && dato.equals(actual.dato))) {

                // Caso 1: Es el único nodo de la lista
                if (actual == cabeza && actual == cola) {
                    cabeza = null;
                    cola = null;
                }
                // Caso 2: El nodo a eliminar es la cabeza
                else if (actual == cabeza) {
                    cabeza = cabeza.siguiente;
                    cabeza.anterior = null;
                }
                // Caso 3: El nodo a eliminar es la cola
                else if (actual == cola) {
                    cola = cola.anterior;
                    cola.siguiente = null;
                }
                // Caso 4: El nodo está en medio de la lista
                else {
                    actual.anterior.siguiente = actual.siguiente;
                    actual.siguiente.anterior = actual.anterior;
                }

                tamanio--;
                return true; // Elemento encontrado y eliminado
            }
            actual = actual.siguiente;
        }

        return false; // Elemento no encontrado
    }

    // Imprimir los elementos desde el inicio hacia el final
    public void imprimirHaciaAdelante() {
        if (estaVacia()) {
            System.out.println("Lista vacía: []");
            return;
        }

        System.out.print("Impresión hacia adelante: [ ");
        Nodo<T> actual = cabeza;
        while (actual != null) {
            System.out.print(actual.dato + (actual.siguiente != null ? " <-> " : ""));
            actual = actual.siguiente;
        }
        System.out.println(" ]");
    }

    // Imprimir los elementos desde el final hacia el inicio
    public void imprimirHaciaAtras() {
        if (estaVacia()) {
            System.out.println("Lista vacía: []");
            return;
        }

        System.out.print("Impresión hacia atrás:     [ ");
        Nodo<T> actual = cola;
        while (actual != null) {
            System.out.print(actual.dato + (actual.anterior != null ? " <-> " : ""));
            actual = actual.anterior;
        }
        System.out.println(" ]");
    }
}

// -----------------------------------------------------------------------------
// 3. CLASE PRINCIPAL (Demostración)
// -----------------------------------------------------------------------------
public class ListaDobleDemo {
    public static void main(String[] args) {
        ListaDoblementeEnlazada<String> lista = new ListaDoblementeEnlazada<>();

        System.out.println("=== PRUEBA DE LISTA DOBLEMENTE ENLAZADA ===\n");

        // 1. Inserciones
        lista.insertarFinal("B");
        lista.insertarFinal("C");
        lista.insertarInicio("A"); // Lista actual: A <-> B <-> C
        lista.insertarFinal("D"); // Lista actual: A <-> B <-> C <-> D

        // 2. Impresiones iniciales
        lista.imprimirHaciaAdelante();
        lista.imprimirHaciaAtras();

        // 3. Prueba de eliminación en diferentes casos
        System.out.println("\n--- Eliminaciones ---");

        // Eliminar nodo intermedio ('B')
        System.out.println("Eliminando 'B': " + lista.eliminar("B"));
        lista.imprimirHaciaAdelante();

        // Eliminar cabeza ('A')
        System.out.println("Eliminando 'A' (cabeza): " + lista.eliminar("A"));
        lista.imprimirHaciaAdelante();

        // Eliminar cola ('D')
        System.out.println("Eliminando 'D' (cola): " + lista.eliminar("D"));
        lista.imprimirHaciaAdelante();
        lista.imprimirHaciaAtras();

        // Eliminar el último elemento restante ('C')
        System.out.println("Eliminando 'C' (único nodo): " + lista.eliminar("C"));
        lista.imprimirHaciaAdelante();
    }
}
