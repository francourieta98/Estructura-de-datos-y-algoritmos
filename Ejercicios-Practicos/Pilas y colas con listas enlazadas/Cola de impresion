/**
 * Ejercicio 9: Cola de impresión utilizando una lista enlazada (FIFO).
 */

// -----------------------------------------------------------------------------
// 1. CLASE TRABAJO IMPRESIÓN (Nodo de la lista enlazada)
// -----------------------------------------------------------------------------
class TrabajoImpresion {
    private String nombreArchivo;
    private int cantidadPaginas;
    private String usuario;
    private TrabajoImpresion siguiente;

    public TrabajoImpresion(String nombreArchivo, int cantidadPaginas, String usuario) {
        this.nombreArchivo = nombreArchivo;
        this.cantidadPaginas = cantidadPaginas;
        this.usuario = usuario;
        this.siguiente = null;
    }

    // Getters y Setters
    public String getNombreArchivo() {
        return nombreArchivo;
    }

    public int getCantidadPaginas() {
        return cantidadPaginas;
    }

    public String getUsuario() {
        return usuario;
    }

    public TrabajoImpresion getSiguiente() {
        return siguiente;
    }

    public void setSiguiente(TrabajoImpresion siguiente) {
        this.siguiente = siguiente;
    }

    @Override
    public String toString() {
        return "Archivo: '" + nombreArchivo + "' | Páginas: " + cantidadPaginas + " | Usuario: " + usuario;
    }
}

// -----------------------------------------------------------------------------
// 2. CLASE COLA DE IMPRESIÓN (Estructura FIFO)
// -----------------------------------------------------------------------------
class ColaImpresion {
    private TrabajoImpresion frente;
    private TrabajoImpresion fin;

    public ColaImpresion() {
        this.frente = null;
        this.fin = null;
    }

    // Verifica si la cola está vacía
    public boolean estaVacia() {
        return frente == null;
    }

    // Agregar trabajo al final de la cola (Enqueue)
    public void agregarTrabajo(String nombreArchivo, int cantidadPaginas, String usuario) {
        TrabajoImpresion nuevo = new TrabajoImpresion(nombreArchivo, cantidadPaginas, usuario);
        if (estaVacia()) {
            frente = nuevo;
            fin = nuevo;
        } else {
            fin.setSiguiente(nuevo);
            fin = nuevo;
        }
        System.out.println("[+] Trabajo agregado: " + nombreArchivo + " (" + usuario + ")");
    }

    // Imprimir el próximo trabajo al frente de la cola (Dequeue)
    public void imprimirProximoTrabajo() {
        if (estaVacia()) {
            System.out.println("[!] No hay trabajos pendientes para imprimir.");
            return;
        }

        TrabajoImpresion trabajoImpreso = frente;
        frente = frente.getSiguiente();

        // Si la cola quedó vacía, se actualiza el puntero del final
        if (frente == null) {
            fin = null;
        }

        System.out.println("[▶] Imprimiendo -> " + trabajoImpreso);
    }

    // Consultar el próximo archivo a imprimir sin eliminarlo (Peek)
    public void consultarProximo() {
        if (estaVacia()) {
            System.out.println("[i] La cola está vacía. No hay trabajos en espera.");
        } else {
            System.out.println("[i] Próximo trabajo a imprimir: " + frente);
        }
    }

    // Mostrar todos los trabajos pendientes
    public void mostrarPendientes() {
        if (estaVacia()) {
            System.out.println("\n--- Lista de Pendientes: (Cola Vacía) ---");
            return;
        }

        System.out.println("\n--- Trabajos Pendientes en Cola (Orden FIFO) ---");
        TrabajoImpresion actual = frente;
        int posicion = 1;

        while (actual != null) {
            System.out.println("  " + posicion + ". " + actual);
            actual = actual.getSiguiente();
            posicion++;
        }
        System.out.println("-----------------------------------------------\n");
    }
}

// -----------------------------------------------------------------------------
// 3. CLASE PRINCIPAL (Pruebas del sistema)
// -----------------------------------------------------------------------------
public class ColaImpresionDemo {
    public static void main(String[] args) {
        ColaImpresion impresora = new ColaImpresion();

        System.out.println("=== SISTEMA DE COLA DE IMPRESIÓN ===\n");

        // 1. Agregar trabajos de distintos usuarios
        impresora.agregarTrabajo("Reporte_Finanzas.pdf", 12, "JuanPerez");
        impresora.agregarTrabajo("Tesis_Final.docx", 85, "MariaGomez");
        impresora.agregarTrabajo("Plano_Arquitectura.dwg", 3, "CarlosLopez");

        // 2. Ver lista completa de pendientes
        impresora.mostrarPendientes();

        // 3. Consultar cuál es el próximo sin eliminarlo
        impresora.consultarProximo();

        // 4. Imprimir el próximo trabajo (debe procesar primero 'Reporte_Finanzas.pdf')
        System.out.println();
        impresora.imprimirProximoTrabajo();

        // 5. Ver estado de la cola tras imprimir un trabajo
        impresora.mostrarPendientes();

        // 6. Imprimir los trabajos restantes
        impresora.imprimirProximoTrabajo();
        impresora.imprimirProximoTrabajo();

        // 7. Intentar imprimir cuando ya no quedan trabajos
        impresora.imprimirProximoTrabajo();
    }
}
